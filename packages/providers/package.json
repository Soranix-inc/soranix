{
  "name": "@packages/providers",
  "version": "1.0.0",
  "description": "Third-party provider integrations for Soranix",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types/index.js",
    "./tagpay": "./dist/tagpay/index.js",
    "./buypower": "./dist/buypower/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
