{
  "name": "@packages/tracing",
  "version": "1.0.0",
  "description": "Distributed tracing utilities for Soranix",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    "./tracer": "./src/tracer.js",
    "./span-utils": "./src/span-utils.js",
    "./config": "./src/config.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/sdk-node": "^0.45.1",
    "@opentelemetry/auto-instrumentations-node": "^0.40.3",
    "@opentelemetry/exporter-jaeger": "^1.18.1",
    "@opentelemetry/exporter-otlp-http": "^0.26.0",
    "@opentelemetry/instrumentation-http": "^0.45.1",
    "@opentelemetry/instrumentation-express": "^0.32.1",
    "@opentelemetry/instrumentation-amqplib": "^0.32.0",
    "@opentelemetry/semantic-conventions": "^1.18.1"
  },
  "devDependencies": {
    "@tooling/eslint-config": "*",
    "@tooling/prettier": "*",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "tracing",
    "opentelemetry",
    "jaeger",
    "microservices",
    "observability"
  ],
  "author": "Soranix Team",
  "license": "MIT"
}
