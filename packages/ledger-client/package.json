{
  "name": "@packages/ledger-client",
  "version": "1.0.0",
  "description": "HTTP client for Ledger Service with caching support",
  "main": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client/ledger-client.ts",
      "types": "./src/client/ledger-client.ts"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "types": "./src/types/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "ledger",
    "client",
    "soranix"
  ],
  "author": "Soranix Team",
  "license": "MIT",
  "dependencies": {
    "@packages/config": "*",
    "@packages/logging": "*",
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@tooling/eslint-config": "*",
    "@tooling/prettier": "*",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}



