{
  "name": "@packages/middleware",
  "version": "1.0.0",
  "description": "Authentication and financial middleware for Soranix services",
  "main": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./middleware": {
      "import": "./src/middleware/require-auth.ts",
      "types": "./src/middleware/require-auth.ts"
    },
    "./middleware/require-auth": {
      "import": "./src/middleware/require-auth.ts",
      "types": "./src/middleware/require-auth.ts"
    },
    "./middleware/optional-auth": {
      "import": "./src/middleware/optional-auth.ts",
      "types": "./src/middleware/optional-auth.ts"
    },
    "./middleware/require-roles": {
      "import": "./src/middleware/require-roles.ts",
      "types": "./src/middleware/require-roles.ts"
    },
    "./types": {
      "import": "./src/types/auth-context.ts",
      "types": "./src/types/auth-context.ts"
    },
    "./errors": {
      "import": "./src/errors/auth-errors.ts",
      "types": "./src/errors/auth-errors.ts"
    },
    "./financial": {
      "import": "./src/middleware/financial/index.ts",
      "types": "./src/middleware/financial/index.ts"
    },
    "./financial/validate-balance": {
      "import": "./src/middleware/financial/validate-balance.ts",
      "types": "./src/middleware/financial/validate-balance.ts"
    },
    "./financial/attach-balance": {
      "import": "./src/middleware/financial/attach-balance.ts",
      "types": "./src/middleware/financial/attach-balance.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "authentication",
    "middleware",
    "jwt",
    "soranix"
  ],
  "author": "Soranix Team",
  "license": "MIT",
  "dependencies": {
    "@packages/config": "*",
    "@packages/ledger-client": "*",
    "@packages/logging": "*",
    "@packages/utils": "*",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@tooling/eslint-config": "*",
    "@tooling/prettier": "*",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
