# Gateway Configuration
PORT=8000
NODE_ENV=development

# Service URLs (development)
AUTH_SERVICE_URL=http://localhost:6000
USERS_SERVICE_URL=http://localhost:6001
BANKING_SERVICE_URL=http://localhost:5003
PAYMENTS_SERVICE_URL=http://localhost:5005
LEDGER_SERVICE_URL=http://localhost:6002
PORTFOLIO_SERVICE_URL=http://localhost:5010
BILLS_PAYMENT_SERVICE_URL=http://localhost:5004
TRANSFERS_SERVICE_URL=http://localhost:5006
FLOWS_SERVICE_URL=http://localhost:5007
MONEY_MANAGEMENT_SERVICE_URL=http://localhost:5008
NOTIFICATION_SERVICE_URL=http://localhost:5009
BILLING_SERVICE_URL=http://localhost:5011
AI_SERVICE_URL=http://localhost:5006

# Kubernetes Service URLs (production)
# AUTH_SERVICE_URL=http://auth-service:80
# USERS_SERVICE_URL=http://users-service:80
# BANKING_SERVICE_URL=http://banking-service:80
# PAYMENTS_SERVICE_URL=http://payments-service:80
# LEDGER_SERVICE_URL=http://ledger-service:80
# PORTFOLIO_SERVICE_URL=http://portfolio-service:80
# BILLS_PAYMENT_SERVICE_URL=http://bills-payment-service:80
# TRANSFERS_SERVICE_URL=http://transfers-service:80
# FLOWS_SERVICE_URL=http://flows-service:80
# MONEY_MANAGEMENT_SERVICE_URL=http://money-management-service:80
# NOTIFICATION_SERVICE_URL=http://notification-service:80
# BILLING_SERVICE_URL=http://billing-service:80
# AI_SERVICE_URL=http://ai-service:80

# JWT Configuration (for token verification)
JWT_SECRET=your-jwt-secret-key-change-this
JWT_ISSUER=soranix-auth
JWT_AUDIENCE=soranix

# Redis Configuration (for rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PUBLIC_MAX=10
RATE_LIMIT_PROTECTED_MAX=200

# Logging
LOG_LEVEL=info

# Tracing (Optional)
JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_ENABLED=true
TRACING_SAMPLING_RATIO=1.0

