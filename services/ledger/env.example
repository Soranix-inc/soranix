# Server Configuration
PORT=6002
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://soranix:soranix@localhost:5432/ledger_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=soranix
REDIS_DB=0

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Event Encryption
EVENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Service Info
SERVICE_NAME=soranix-ledger
SERVICE_VERSION=1.0.0

# Tracing (Optional)
JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_ENABLED=true
TRACING_SAMPLING_RATIO=1.0

# Ledger Configuration
LEDGER_RETENTION_DAYS=2555  # 7 years for compliance
LEDGER_SERVICE_URL=http://localhost:6002/api/v1

# Caching Configuration
BALANCE_CACHE_TTL=30  # 30 seconds

