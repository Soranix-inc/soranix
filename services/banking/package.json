{
  "name": "@soranix/banking",
  "version": "1.0.0",
  "description": "Banking microservice for Soranix platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push"
  },
  "keywords": [
    "microservice",
    "banking",
    "soranix",
    "nodejs",
    "typescript"
  ],
  "author": "Soranix Team",
  "license": "MIT",
  "dependencies": {
    "@packages/analytics": "*",
    "@packages/errors": "*",
    "@packages/events": "*",
    "@packages/logging": "*",
    "@packages/metrics": "*",
    "@packages/providers": "*",
    "@packages/rabbitmq": "*",
    "@packages/tracing": "*",
    "@tooling/eslint-config": "*",
    "axios": "^1.9.0",
    "body-parser": "^2.2.0",
    "chalk": "^5.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pg": "^8.16.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "drizzle-kit": "^0.20.6",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
