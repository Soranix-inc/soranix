FROM node:24-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 banking && \
    chown -R banking:nodejs /app

USER banking

# ─── Expose Port ───────────────────────────────
EXPOSE 5005

# ─── Development Entrypoint ────────────────────
CMD ["npm", "run", "dev"]












